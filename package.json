{
  "name": "d2r-ingame-navigator",
  "version": "1.4.0",
  "description": "디아2-인게임-내비게이터 — 디아블로 II: 레저렉션 인게임 퀘스트·길찾기 HUD & 호라드림 룬워드·큐빙 대사전",
  "main": "index.js",
  "scripts": {
    "extract:assets": "node scripts/extract-d2r-assets.cjs",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "app:start": "electron .",
    "verify": "node scripts/package-and-verify.cjs"
  },
  "build": {
    "appId": "com.sanctuary.d2rhud",
    "productName": "D2R-HUD",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.js",
      "web/dist/**/*"
    ]
  }
}
